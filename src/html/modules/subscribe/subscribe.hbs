<section class="subscribe" data-script="subscribe" >
  <div class="wrap">
    <div class="subscribe__inner">

      {{#if subheading}}
      <p class="subscribe__subheading">{{subheading}}</p>
      {{/if}}

      {{#if heading}}
      <h2 class="subscribe__heading">{{heading}}</h2>
      {{/if}}

      {{#if body}}
      <p class="subscribe__body">{{body}}</p>
      {{/if}}

      {{#if form}}
      <div class="subscribe__form-wrap">
        <form
          class="subscribe__form js-subscribe__form"
          action="{{form.action}}"
          method="post"
          novalidate
        >
        <div class="subscribe__field">
          <input
            class="subscribe__input"
            type="email"
            name="email"
            id="js-subscribe-email"
            autocomplete="email"
            placeholder=" "
            aria-label="{{form.inputLabel}}"
            required
          
          >
          <label class="subscribe__label" for="js-subscribe-email">
            {{form.inputPlaceholder}}
          </label>
        </div>
          <button class="subscribe__submit" type="submit">
            {{form.submitText}}
            <span class="subscribe__submit-icon" aria-hidden="true"></span>
          </button>
        </form>
      </div>
      {{/if}}

    </div>
  </div>
</section>