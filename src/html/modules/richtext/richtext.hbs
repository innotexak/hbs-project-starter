<section class="richtext">
  <div class="wrap">
    <div class="richtext__inner" data-animate data-animate-direction="right">

      {{#if subheading}}
      <p class="richtext__subheading">{{subheading}}</p>
      {{/if}}

      {{#if body}}
      <p class="richtext__body">{{body}}</p>
      {{/if}}

    </div>
  </div>
</section>