<div class="section-divider">
  <img class="divider" src="assets/images/divider.png" alt="divider"/>
</div>
<section class="tabs-accordion" data-script="tabs-accordion">

  <div class="wrap">

    {{#if tabs}}
    <div class="tabs-accordion__tabs" role="tablist" aria-label="Content tabs">
      {{#each tabs}}
      <button
        class="tabs-accordion__tab{{#if this.active}} tabs-accordion__tab--active{{/if}}"
        role="tab"
        aria-selected="{{#if this.active}}true{{else}}false{{/if}}"
        aria-controls="tab-panel-{{@index}}"
        tabindex="{{#if this.active}}0{{else}}-1{{/if}}"
        type="button"
      >
        {{this.label}}
      </button>
      {{/each}}
    </div>

    {{#each tabs}}
    <div
      class="tabs-accordion__panel{{#if this.active}} tabs-accordion__panel--active{{/if}}"
      role="tabpanel"
      id="tab-panel-{{@index}}"
    >
      <div class="tabs-accordion__panel-inner">

        <div class="tabs-accordion__panel-left">
          {{#if this.subheading}}
          <p class="tabs-accordion__subheading">{{this.subheading}}</p>
          {{/if}}
          {{#if this.heading}}
          <h2 class="tabs-accordion__heading">{{this.heading}}</h2>
          {{/if}}
        </div>

        {{#if this.accordion}}
        <div class="tabs-accordion__panel-right">
          <ul class="accordion js-accordion" role="list">
            {{#each this.accordion}}
           <li class="accordion__item js-accordion-item{{#if this.open}}  accordion__item--open{{/if}}">
              <button
                class="accordion__trigger js-accordion-button"
                aria-expanded="false"
                type="button"
              >
                <span class="accordion__title">{{this.title}}</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </button>
              <div class="accordion__body js-accordion-body">
                <div class="accordion__content js-accordion-content">
                  {{this.body}}
                </div>
              </div>
            </li>
            {{/each}}
          </ul>
        </div>
        {{/if}}

      </div>
    </div>
    {{/each}}
    {{/if}}

  </div>
</section>