
<img class="divider" src="assets/images/divider.png" alt="divider"/>

<section class="blocktext">
  <div class="wrap">
    <div class="blocktext__content" data-animate data-animate-direction="right">
      {{#if title}}
        <div class="blocktext__button-wrapper">
          <button class="blocktext__content-button" type="button">
            {{title}}
          </button>
        </div>
      {{/if}}

      {{#if content}}
        <p class="blocktext__content-text" >
          {{content}}
        </p>
      {{/if}}

    </div>
  </div>
</section>